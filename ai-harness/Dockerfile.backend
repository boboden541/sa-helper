# Backend + демон AI-Harness (общая библиотека домена, СТ §2.3)
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl xz-utils git ca-certificates docker.io docker-cli \
 && rm -rf /var/lib/apt/lists/*

# Node 20 под Claude Code CLI — Eve-агент (решение владельца 28.10.2026);
# docker.io — CLI для управления контейнерами через смонтированный сокет
RUN ARCH=$(uname -m | sed 's/x86_64/x64/; s/aarch64/arm64/') \
 && curl -fsSL "https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-${ARCH}.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
 && npm install -g @anthropic-ai/claude-code

WORKDIR /app
COPY pyproject.toml ./
COPY alembic.ini ./
COPY backend/src ./backend/src
COPY daemon ./daemon
COPY db ./db

# db.seeds.flow_seed (пресеты flow) импортируется контуром «+ тип задачи»
ENV PYTHONPATH="/app/backend/src:/app"

RUN pip install --no-cache-dir . && pip install --no-cache-dir 'claude-agent-sdk>=0.2.174,<0.3'

# демон запускается той же библиотекой домена (python -m daemon.main)
EXPOSE 8000
# --workers 1 обязателен: кэш графов — в процессе backend (интенты Eve уже
# в БД; решение владельца 03.11.2026 — масштабирование ограничено этим).
# Миграции при старте: раньше требовали ручного venv на хосте, пустая схема
# выглядела как здоровый сервис (healthz не ходит в БД) — анализ 11.11.2026
CMD ["sh", "-c", "alembic -c /app/alembic.ini upgrade head && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir /app/backend/src --workers 1"]
