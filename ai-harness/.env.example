# AI-Harness: локальные настройки (скопируйте в .env)
# База данных (docker compose up -d postgres поднимает её на 5433)
DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5433/ai_harness
# Тестовая БД (создаётся/пересоздаётся тестами)
TEST_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5433/ai_harness_test

# Ключ шифрования API-токенов провайдеров (AES-256-GCM), base64 от 32 байт.
# Сгенерировать: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AI_HARNESS_TOKEN_KEY=

# Сессии
SESSION_TTL_HOURS=12

# Демон
DAEMON_TICK_SECONDS=30

# DNS контейнеров backend/daemon (docker compose). Дефолт 8.8.8.8 работает
# дома; в корпоративной сети внешний DNS обычно заблокирован — укажите DNS
# своей сети (macOS: scutil --dns | grep nameserver), иначе Eve и агенты
# не достучатся до провайдера (ошибка EAI_AGAIN)
CONTAINER_DNS=8.8.8.8

# Мастер-ключ моста LiteLLM (SDK прогона авторизуется им). Смените на свой:
# любой, кто достучается до litellm:4000 в сети compose, пользуется ключами
# провайдеров. ДЕФОЛТ sk-harness-bridge — только для локальной разработки.
LITELLM_MASTER_KEY=sk-harness-bridge

# CORS-источники backend'а через запятую (прод-деплой: домен фронтенда).
# Дефолт: http://localhost:5173 (dev-режим Vite)
BACKEND_CORS_ORIGINS=http://localhost:5173

# Cookie сессий: флаг Secure (требуется HTTPS-терминатор вне localhost)
SESSION_COOKIE_SECURE=false
